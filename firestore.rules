rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player reads and writes only their own farm.
    match /farms/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    // Public leaderboard: anyone reads; a signed-in player writes only
    // their own row, with sane values.
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'score', 'orders', 'village', 'house', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 300
        && request.resource.data.score is int
        && request.resource.data.score >= request.resource.data.level * 1000000
        && request.resource.data.score < (request.resource.data.level + 1) * 1000000
        && request.resource.data.orders is int
        && request.resource.data.orders >= 0
        && request.resource.data.orders < 1000000
        && request.resource.data.village is int
        && request.resource.data.village >= 0
        && request.resource.data.village < 100000
        && request.resource.data.house is int
        && request.resource.data.updated == request.time;
    }

    // Public village (farm layout) for the region map: signed-in players
    // read; each player writes only their own.
    match /villages/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.level is int
        && request.resource.data.objs is list
        && request.resource.data.objs.size() <= 1400
        && request.resource.data.updated == request.time;
    }

    // What visitors did on a farm (thu hoạch hộ / hái trộm / bị bắt):
    // a visitor only creates (one per action per harvest, never updates);
    // the owner reads and deletes them.
    match /visits/{owner}/events/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == owner;
      allow create: if request.auth != null
        && request.auth.uid != owner
        && request.resource.data.from == request.auth.uid
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.kind in ['help', 'steal', 'caught']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.obj is int
        && request.resource.data.start is int
        && request.resource.data.fine is int
        && request.resource.data.fine >= 0
        && request.resource.data.fine <= 5000
        && request.resource.data.keys().hasOnly(['from', 'name', 'kind', 'obj', 'start', 'item', 'fine', 'at']);
    }

    // Chợ phiên: a seller puts goods on one of their stalls ({uid}_{slot});
    // signed-in players read them; another player buys by setting buyer
    // (once, nothing else changes); the seller collects and deletes.
    match /stalls/{id} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
      allow create: if request.auth != null
        && id.matches(request.auth.uid + '_[0-9]')
        && request.resource.data.keys().hasOnly(['owner', 'name', 'item', 'qty', 'price', 'slot', 'buyer', 'created'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.item is string
        && request.resource.data.item.size() <= 20
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1
        && request.resource.data.qty <= 20
        && request.resource.data.price is int
        && request.resource.data.price >= 1
        && request.resource.data.price <= 200000
        && request.resource.data.slot is int
        && request.resource.data.buyer == null
        && request.resource.data.created == request.time;
      allow update: if request.auth != null
        && request.auth.uid != resource.data.owner
        && resource.data.buyer == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyer', 'buyerName', 'sold'])
        && request.resource.data.buyer == request.auth.uid
        && request.resource.data.buyerName is string
        && request.resource.data.buyerName.size() <= 24
        && request.resource.data.sold == request.time;
    }
  }
}
